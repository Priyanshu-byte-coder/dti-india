# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.env

# Model caches and logs
.hf_cache/
logs/

# Generated outputs (reproducible from code + corpus; large)
data/llm/
data/processed/
# Result tables (estimates only) are committed; dry runs, mock outputs and row-level exports are not
reports/*
!reports/econ_onet/
!reports/econ_llm*/
!reports/gap/
!reports/pilot_*.csv
!reports/stability_runs.csv
!reports/cross_model.csv
!reports/q9_vs_equal_weight.csv
!reports/unstable_occupations.csv
reports/**/grf_input.csv

# Filled human coder forms: personal data of coders, shared privately
data/human/

# Raw downloads: PLFS microdata stays out (MoSPI terms do not allow redistribution).
# O*NET (CC BY 4.0) and BLS (US public domain) raw files are committed so nobody has to
# download them again; bls.gov blocks scripted downloads.
data/raw/*
!data/raw/onet/
!data/raw/bls/

# Synthetic PLFS for dry runs (regenerate with `dti synth-plfs`)
data/synthetic/

# Excel lock files
~$*.xlsx
